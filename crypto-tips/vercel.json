{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/coinbase/holdings.js": {
      "maxDuration": 30
    },
    "api/social.js": {
      "maxDuration": 30
    },
    "api/push.js": {
      "maxDuration": 60,
      "includeFiles": "public/{sellplan,indicators}.js"
    }
  },
  "rewrites": [
    {
      "source": "/some-test",
      "destination": "/draft.html"
    },
    {
      "source": "/some-test/",
      "destination": "/draft.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push?action=run",
      "schedule": "7 15 * * *"
    }
  ]
}