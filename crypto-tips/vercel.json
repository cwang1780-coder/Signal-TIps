{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/coinbase/holdings.js": {
      "maxDuration": 30
    },
    "api/social.js": {
      "maxDuration": 30
    },
    "api/push.js": {
      "maxDuration": 60,
      "includeFiles": "public/{sellplan,indicators}.js"
    },
    "api/account.js": {
      "includeFiles": "admin-ui/admin.html"
    }
  },
  "rewrites": [
    {
      "source": "/control",
      "has": [
        {
          "type": "host",
          "value": "signal-tips-control.vercel.app"
        }
      ],
      "destination": "/api/account?action=adminPage"
    },
    {
      "source": "/some-test",
      "destination": "/draft.html"
    },
    {
      "source": "/some-test/",
      "destination": "/draft.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push?action=run",
      "schedule": "7 15 * * *"
    }
  ]
}