function drawArt1(){
  const cv=document.getElementById('art1');
  cv.width=cv.offsetWidth||400;cv.height=cv.offsetHeight||400;
  const ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height;
  ctx.fillStyle='#020810';ctx.fillRect(0,0,W,H);
  // grid lines
  for(let x=0;x<W;x+=30){
    const alpha=0.04+0.1*Math.abs(Math.sin(x*0.05));
    ctx.strokeStyle=`rgba(0,245,255,${alpha})`;ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();
  }
  for(let y=0;y<H;y+=30){
    const alpha=0.04+0.1*Math.abs(Math.sin(y*0.05));
    ctx.strokeStyle=`rgba(0,245,255,${alpha})`;ctx.lineWidth=1;
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
  }
  // buildings silhouette
  ctx.fillStyle='#0a1520';
  [[0,60,50,160],[55,90,40,130],[100,40,60,180],[165,70,45,150],[215,50,55,170],[275,80,50,140],[330,45,60,175],[390,65,55,155]].forEach(([x,h,w,base])=>{
    ctx.fillRect(x,H-base,w,base);
  });
  // windows
  ctx.fillStyle='rgba(255,200,50,0.6)';
  for(let i=0;i<60;i++){
    const bx=Math.floor(Math.random()*8);
    const configs=[[0,50,160],[55,40,130],[100,60,180],[165,45,150],[215,55,170],[275,50,140],[330,60,175],[390,55,155]];
    const [bx2,bw,bbase]=configs[bx];
    const wx=bx2+5+Math.random()*(bw-10);
    const wy=H-bbase+5+Math.random()*(bbase-20);
    ctx.fillRect(wx,wy,4,6);
  }
  // glow horizon
  const grad=ctx.createLinearGradient(0,H*.6,0,H);
  grad.addColorStop(0,'rgba(0,245,255,0.08)');grad.addColorStop(1,'transparent');
  ctx.fillStyle=grad;ctx.fillRect(0,H*.6,W,H*.4);
  // moon
  ctx.beginPath();ctx.arc(W*.75,H*.15,22,0,Math.PI*2);
  ctx.fillStyle='rgba(0,245,255,0.15)';ctx.fill();
  ctx.strokeStyle='rgba(0,245,255,0.5)';ctx.lineWidth=1;ctx.stroke();
}

function drawArt2(){
  const cv=document.getElementById('art2');
  cv.width=cv.offsetWidth||400;cv.height=cv.offsetHeight||400;
  const ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height;
  ctx.fillStyle='#020810';ctx.fillRect(0,0,W,H);
  const cx=W/2,cy=H/2;
  // rings
  [140,110,80,55,35].forEach((r,i)=>{
    ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);
    const alpha=[.12,.18,.25,.35,.5][i];
    ctx.strokeStyle=`rgba(0,245,255,${alpha})`;ctx.lineWidth=i===4?2:1;ctx.stroke();
    if(i<4){
      // orbit dot
      const angle=Math.random()*Math.PI*2;
      ctx.beginPath();ctx.arc(cx+Math.cos(angle)*r,cy+Math.sin(angle)*r,3,0,Math.PI*2);
      ctx.fillStyle=['#ff6b00','#39ff14','#ff2d55','#00f5ff'][i];ctx.fill();
    }
  });
  // planet core
  const grd=ctx.createRadialGradient(cx,cy,0,cx,cy,30);
  grd.addColorStop(0,'rgba(0,245,255,0.8)');
  grd.addColorStop(.5,'rgba(0,100,200,0.4)');
  grd.addColorStop(1,'transparent');
  ctx.fillStyle=grd;ctx.beginPath();ctx.arc(cx,cy,30,0,Math.PI*2);ctx.fill();
  // stars
  for(let i=0;i<80;i++){
    const sx=Math.random()*W,sy=Math.random()*H;
    const d=Math.sqrt((sx-cx)**2+(sy-cy)**2);
    if(d>150){
      ctx.fillStyle=`rgba(255,255,255,${Math.random()*.7})`;
      ctx.fillRect(sx,sy,1,1);
    }
  }
}

function drawArt3(){
  const cv=document.getElementById('art3');
  cv.width=cv.offsetWidth||400;cv.height=cv.offsetHeight||400;
  const ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height;
  ctx.fillStyle='#020810';ctx.fillRect(0,0,W,H);
  const chars='01アイウエオルABCXYZ!@#$%<>';
  ctx.font=`${14}px 'Share Tech Mono'`;
  for(let x=0;x<W;x+=16){
    for(let y=0;y<H;y+=20){
      const c=chars[Math.floor(Math.random()*chars.length)];
      const t=y/H;
      const alpha=.05+t*.4*(Math.random()>.7?1:.3);
      const g=Math.floor(100+t*155);
      ctx.fillStyle=`rgba(57,255,20,${alpha})`;
      ctx.fillText(c,x,y);
    }
  }
  // vertical bright streaks
  for(let i=0;i<5;i++){
    const sx=Math.random()*W;
    const grad=ctx.createLinearGradient(sx,0,sx,H);
    grad.addColorStop(0,'transparent');
    grad.addColorStop(Math.random()*.5,'rgba(57,255,20,0.6)');
    grad.addColorStop(1,'transparent');
    ctx.fillStyle=grad;ctx.fillRect(sx,0,2,H);
  }
}

function drawArt4(){
  const cv=document.getElementById('art4');
  cv.width=cv.offsetWidth||400;cv.height=cv.offsetHeight||400;
  const ctx=cv.getContext('2d');
  const W=cv.width,H=cv.height;
  ctx.fillStyle='#020810';ctx.fillRect(0,0,W,H);
  const cx=W/2,cy=H/2;
  function drawFractal(x,y,size,depth){
    if(depth<=0||size<2)return;
    const t=depth/8;
    const r=Math.round(0+t*0);const g=Math.round(200*t);const b=Math.round(255*t);
    ctx.strokeStyle=`rgba(${r},${g},${b+50},${t*.8})`;
    ctx.lineWidth=depth*.4;
    for(let a=0;a<6;a++){
      const angle=(a/6)*Math.PI*2;
      const nx=x+Math.cos(angle)*size,ny=y+Math.sin(angle)*size;
      ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(nx,ny);ctx.stroke();
      drawFractal(nx,ny,size*.55,depth-1);
    }
  }
  drawFractal(cx,cy,80,8);
  // center glow
  const grd=ctx.createRadialGradient(cx,cy,0,cx,cy,40);
  grd.addColorStop(0,'rgba(0,245,255,0.9)');
  grd.addColorStop(.4,'rgba(0,245,255,0.2)');
  grd.addColorStop(1,'transparent');
  ctx.fillStyle=grd;ctx.beginPath();ctx.arc(cx,cy,40,0,Math.PI*2);ctx.fill();
}

