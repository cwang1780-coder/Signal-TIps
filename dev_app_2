        break;
      }
      case 'template':{
        const tpl=document.getElementById('tplSelect').value;
        prompt=`Write a clean, working Roblox Luau script template for a roleplay server for the following: "${tpl}". Include comments explaining each section. Output ONLY the Lua code.`;
        resultId='template';
        break;
      }
      case 'names':{
        const role=document.getElementById('nameRole').value;
        const nat=document.getElementById('nameNat').value||'mixed';
        const count=document.getElementById('nameCount').value;
        prompt=`Generate ${count} unique roleplay character names for a Roblox RP server. Role: ${role}. Nationality/vibe: ${nat}. For each name give: Full Name, Nickname, and a 1-sentence backstory. Format as a numbered list.`;
        break;
      }
      case 'factions':{
        const ft=document.getElementById('factionType').value;
        const th=document.getElementById('factionTheme').value||'generic';
        prompt=`Generate 4 unique faction/gang names for a Roblox RP server. Type: ${ft}. Theme: ${th}. For each include: Name, Tag/Abbreviation, Motto, and 1-line description. Format clearly.`;
        resultId='factions';
        break;
      }
      case 'events':{
        const et=document.getElementById('evtType').value;
        const es=document.getElementById('evtScale').value;
        prompt=`Design a detailed roleplay event for a Roblox RP server. Event type: ${et}. Scale: ${es}. Include: Overview, Phases (step by step), Roles needed, Objectives, Possible outcomes, and suggested rewards. Be specific and immersive.`;
        break;
      }
      case 'scenario':{
        const mood=document.getElementById('moodSel').value;
        prompt=`Create a random, creative roleplay scenario for a Roblox RP server. Mood: ${mood}. Include: Setup (2 sentences), the inciting incident, 3 possible directions the RP could go, and a dramatic twist. Make it feel cinematic.`;
        resultId='scenario';
        break;
      }
      case 'rules':{
        const rt=document.getElementById('rulesType').value;
        const rs=document.getElementById('rulesStrict').value;
        prompt=`Write a complete set of server rules for a Roblox ${rt} roleplay server. Strictness: ${rs}. Include sections for: General Conduct, Roleplay Rules, Combat Rules, Staff Rules, and Punishment Guidelines. Use clear numbered formatting.`;
        break;
      }
      case 'handbook':{
        const roles=document.getElementById('staffRoles').value||'Admin, Mod, Helper';
        const focus=document.getElementById('staffFocus').value||'City RP server';
        prompt=`Write a concise staff handbook for a Roblox ${focus}. Include roles: ${roles}. Cover: Responsibilities per role, Moderation guidelines, How to handle reports, Do's and Don'ts, and escalation procedures. Keep it professional.`;
        resultId='handbook';
        break;
      }
      case 'crimes':{
        const notes=document.getElementById('crimeNotes').value.trim();
        if(!notes){showResult('crimes','⚠ Please enter crime notes to format.',true);return;}
        prompt=`Format the following raw notes into a professional Roblox RP police report. Include: Incident #, Date/Time (make one up), Reporting Officer, Suspect Info, Crime Description, Evidence, Actions Taken, and Charges Filed. Notes: "${notes}"`;
        break;
      }
      case 'penal':{
        const ps=document.getElementById('penalStyle').value;
        const pc=document.getElementById('penalCount').value;
        prompt=`Generate a penal code for a Roblox RP server with ${pc} charges. Style: ${ps}. For each charge include: Code number, Charge name, Description, and Sentence time (in-game minutes). Format as a clean table or numbered list.`;
        resultId='penal';
        break;
      }
      case 'lore':{
        const ls=document.getElementById('loreSet').value;
        const lt=document.getElementById('loreTone').value;
        prompt=`Write rich server lore for a Roblox RP server set in a ${ls} world. Tone: ${lt}. Include: City/World name, History (2 paragraphs), Current state of affairs, Major factions in power, and a rumor/mystery that players can explore. Make it immersive.`;
        break;
      }
      case 'npc':{
        const nt=document.getElementById('npcType').value;
        const nc=document.getElementById('npcCtx').value||'neutral situation';
        prompt=`Write 6 immersive NPC dialogue lines for a Roblox RP server. NPC type: ${nt}. Context: ${nc}. Mix greetings, warnings, hints, and reactions. Make them feel alive and unique. Number each line.`;
        resultId='npc';
        break;
      }
    }

    // Find and disable the button
    showLoading(resultId);
    const result=await callClaude(prompt);
    showResult(resultId,result,false);
  } catch(err){
    showResult(resultId,'❌ Error: '+err.message,true);
  }
}
</script>

</body>
</html>
