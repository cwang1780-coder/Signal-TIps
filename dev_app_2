<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>LuaDev — Roblox Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@300;400;600;700&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #050a0f;
    --bg2: #080f17;
    --panel: #0a1520;
    --border: #0ff3;
    --cyan: #00f5ff;
    --green: #39ff14;
    --orange: #ff6b00;
    --red: #ff2d55;
    --text: #c8e6f0;
    --dim: #4a7a8a;
    --glow: 0 0 20px #00f5ff55, 0 0 40px #00f5ff22;
    --glow-g: 0 0 20px #39ff1455, 0 0 40px #39ff1422;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Rajdhani',sans-serif;
    font-size:16px;
    overflow-x:hidden;
  }

/* ─── CANVAS BG ─── */
#bgCanvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none;opacity:.35;}

/* ─── NOISE OVERLAY ─── */
body::before{
content:’’;position:fixed;inset:0;
background-image:url(“data:image/svg+xml,%3Csvg viewBox=‘0 0 200 200’ xmlns=‘http://www.w3.org/2000/svg’%3E%3Cfilter id=‘n’%3E%3CfeTurbulence type=‘fractalNoise’ baseFrequency=‘0.9’ numOctaves=‘4’/%3E%3C/filter%3E%3Crect width=‘100%25’ height=‘100%25’ filter=‘url(%23n)’ opacity=‘0.04’/%3E%3C/svg%3E”);
pointer-events:none;z-index:1;opacity:.6;
}

/* ─── SCAN LINES ─── */
body::after{
content:’’;position:fixed;inset:0;
background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,245,255,.015) 2px,rgba(0,245,255,.015) 4px);
pointer-events:none;z-index:1;
}

/* ─── NAV ─── */
nav{
position:fixed;top:0;left:0;right:0;z-index:100;
display:flex;align-items:center;justify-content:space-between;
padding:14px 40px;
background:linear-gradient(180deg,rgba(5,10,15,.95) 0%,rgba(5,10,15,.6) 100%);
border-bottom:1px solid var(–border);
backdrop-filter:blur(12px);
}
.nav-logo{
font-family:‘Orbitron’,sans-serif;font-size:1.1rem;font-weight:900;
color:var(–cyan);text-shadow:var(–glow);letter-spacing:.15em;
}
.nav-logo span{color:var(–green);}
nav ul{display:flex;gap:30px;list-style:none;}
nav ul a{
color:var(–dim);font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;
text-decoration:none;font-family:‘Share Tech Mono’,monospace;
transition:color .2s,text-shadow .2s;
}
nav ul a:hover{color:var(–cyan);text-shadow:0 0 10px var(–cyan);}

/* ─── SECTIONS ─── */
section{position:relative;z-index:2;}

/* ─── HERO ─── */
#hero{
min-height:100vh;display:flex;flex-direction:column;
align-items:center;justify-content:center;
text-align:center;padding:120px 20px 60px;
}
.hero-tag{
font-family:‘Share Tech Mono’,monospace;font-size:.75rem;
color:var(–green);letter-spacing:.2em;text-transform:uppercase;
border:1px solid var(–green);padding:4px 14px;border-radius:2px;
margin-bottom:30px;box-shadow:0 0 12px #39ff1433;
animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:.8}50%{opacity:1;box-shadow:0 0 20px #39ff1466;}}
.hero-title{
font-family:‘Orbitron’,sans-serif;font-size:clamp(2.5rem,7vw,6rem);
font-weight:900;line-height:1;letter-spacing:-.02em;
color:#fff;margin-bottom:10px;
}
.hero-title .hl{color:var(–cyan);text-shadow:var(–glow);}
.hero-sub{
font-family:‘Share Tech Mono’,monospace;font-size:clamp(.85rem,2vw,1.1rem);
color:var(–dim);letter-spacing:.08em;margin-bottom:40px;
}
.hero-sub span{color:var(–orange);}
.hero-stats{
display:flex;gap:40px;justify-content:center;flex-wrap:wrap;margin-bottom:50px;
}
.stat{text-align:center;}
.stat-n{
font-family:‘Orbitron’,sans-serif;font-size:2rem;font-weight:700;
color:var(–cyan);text-shadow:var(–glow);
}
.stat-l{font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;color:var(–dim);}
.cta-row{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}
.btn{
display:inline-flex;align-items:center;gap:8px;
padding:12px 28px;font-family:‘Share Tech Mono’,monospace;
font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;
border:1px solid;border-radius:2px;cursor:pointer;text-decoration:none;
transition:all .25s;
}
.btn-cyan{color:var(–cyan);border-color:var(–cyan);background:transparent;}
.btn-cyan:hover{background:var(–cyan);color:#000;box-shadow:var(–glow);}
.btn-green{color:var(–green);border-color:var(–green);background:transparent;}
.btn-green:hover{background:var(–green);color:#000;box-shadow:var(–glow-g);}

/* ─── SECTION HEADER ─── */
.sec-head{
text-align:center;padding:80px 20px 50px;
}
.sec-label{
font-family:‘Share Tech Mono’,monospace;font-size:.7rem;
letter-spacing:.2em;color:var(–green);text-transform:uppercase;
display:block;margin-bottom:12px;
}
.sec-title{
font-family:‘Orbitron’,sans-serif;font-size:clamp(1.8rem,4vw,3rem);
font-weight:700;color:#fff;letter-spacing:-.01em;
}
.sec-title .hl{color:var(–cyan);}
.sec-line{
width:80px;height:2px;margin:16px auto 0;
background:linear-gradient(90deg,transparent,var(–cyan),transparent);
}

/* ─── PROJECTS ─── */
#projects{padding-bottom:80px;}
.projects-grid{
display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:24px;max-width:1200px;margin:0 auto;padding:0 24px;
}
.proj-card{
background:var(–panel);border:1px solid var(–border);
border-radius:4px;padding:28px;position:relative;overflow:hidden;
transition:border-color .3s,transform .3s,box-shadow .3s;
cursor:default;
}
.proj-card::before{
content:’’;position:absolute;top:0;left:0;right:0;height:2px;
background:linear-gradient(90deg,var(–cyan),var(–green));
transform:scaleX(0);transform-origin:left;transition:transform .4s;
}
.proj-card:hover{
border-color:#0ff8;transform:translateY(-4px);
box-shadow:0 8px 40px #00f5ff18;
}
.proj-card:hover::before{transform:scaleX(1);}
.proj-badge{
display:inline-block;font-family:‘Share Tech Mono’,monospace;font-size:.65rem;
letter-spacing:.15em;text-transform:uppercase;padding:3px 10px;
border-radius:2px;margin-bottom:16px;
}
.badge-lua{background:#ff6b0022;color:var(–orange);border:1px solid #ff6b0055;}
.badge-roblox{background:#00f5ff11;color:var(–cyan);border:1px solid #00f5ff44;}
.badge-system{background:#39ff1411;color:var(–green);border:1px solid #39ff1444;}
.proj-title{
font-family:‘Orbitron’,sans-serif;font-size:1.05rem;font-weight:700;
color:#fff;margin-bottom:10px;
}
.proj-desc{
font-size:.9rem;line-height:1.6;color:var(–dim);margin-bottom:18px;
}
.proj-tags{display:flex;flex-wrap:wrap;gap:8px;}
.tag{
font-family:‘Share Tech Mono’,monospace;font-size:.65rem;
padding:3px 8px;background:#ffffff08;border:1px solid #ffffff15;
color:#7aa8b8;letter-spacing:.08em;
}
.proj-code{
margin-top:18px;background:#020810;border:1px solid #0ff2;
border-radius:3px;padding:14px;overflow-x:auto;
}
.proj-code pre{
font-family:‘Share Tech Mono’,monospace;font-size:.72rem;
line-height:1.7;color:#7dd3fc;white-space:pre;
}
.kw{color:#c084fc;}
.fn{color:#67e8f9;}
.str{color:#86efac;}
.cm{color:#4a5568;}
.nb{color:#fb923c;}

/* ─── DIGITAL ART ─── */
#art{padding-bottom:80px;}
.art-grid{
display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:20px;max-width:1200px;margin:0 auto;padding:0 24px;
}
.art-piece{
aspect-ratio:1;border:1px solid var(–border);border-radius:4px;overflow:hidden;
position:relative;cursor:pointer;
transition:border-color .3s,transform .3s,box-shadow .3s;
}
.art-piece:hover{border-color:var(–cyan);transform:scale(1.02);box-shadow:0 0 30px #00f5ff22;}
.art-piece canvas{width:100%;height:100%;display:block;}
.art-label{
position:absolute;bottom:0;left:0;right:0;
background:linear-gradient(0deg,rgba(5,10,15,.95),transparent);
padding:20px 16px 12px;
font-family:‘Share Tech Mono’,monospace;font-size:.7rem;
letter-spacing:.1em;color:var(–cyan);
}

/* ─── API TOOL ─── */
#api{padding-bottom:100px;}
.api-wrap{max-width:1100px;margin:0 auto;padding:0 24px;}
.api-tabs{
display:flex;gap:0;border-bottom:1px solid var(–border);
margin-bottom:30px;overflow-x:auto;
}
.api-tab{
font-family:‘Share Tech Mono’,monospace;font-size:.75rem;
letter-spacing:.12em;text-transform:uppercase;
padding:12px 22px;border:none;background:transparent;
color:var(–dim);cursor:pointer;border-bottom:2px solid transparent;
white-space:nowrap;transition:color .2s,border-color .2s;
}
.api-tab.active{color:var(–cyan);border-bottom-color:var(–cyan);}
.api-tab:hover:not(.active){color:var(–text);}

.api-panel{display:none;}
.api-panel.active{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
@media(max-width:700px){.api-panel.active{grid-template-columns:1fr;}}

.api-card{
background:var(–panel);border:1px solid var(–border);
border-radius:4px;padding:24px;
}
.api-card h3{
font-family:‘Orbitron’,sans-serif;font-size:.9rem;font-weight:700;
color:var(–cyan);margin-bottom:6px;text-transform:uppercase;letter-spacing:.08em;
}
.api-card p{font-size:.85rem;color:var(–dim);line-height:1.5;margin-bottom:18px;}

label{
display:block;font-family:‘Share Tech Mono’,monospace;
font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;
color:var(–dim);margin-bottom:6px;
}
input,select,textarea{
width:100%;background:#020810;border:1px solid #0ff3;
color:var(–text);font-family:‘Share Tech Mono’,monospace;
font-size:.8rem;padding:10px 14px;border-radius:2px;
outline:none;margin-bottom:14px;
transition:border-color .2s,box-shadow .2s;
}
input:focus,select:focus,textarea:focus{
border-color:var(–cyan);box-shadow:0 0 0 2px #00f5ff18;
}
select option{background:#0a1520;}
textarea{resize:vertical;min-height:80px;}

.api-btn{
width:100%;padding:12px;background:transparent;
border:1px solid var(–cyan);color:var(–cyan);
font-family:‘Share Tech Mono’,monospace;font-size:.8rem;
letter-spacing:.15em;text-transform:uppercase;cursor:pointer;
border-radius:2px;transition:all .25s;display:flex;
align-items:center;justify-content:center;gap:8px;
}
.api-btn:hover{background:var(–cyan);color:#000;box-shadow:var(–glow);}
.api-btn:disabled{opacity:.4;cursor:not-allowed;}

.api-result{
margin-top:18px;background:#020810;border:1px solid #0ff2;
border-radius:3px;padding:16px;min-height:60px;
font-family:‘Share Tech Mono’,monospace;font-size:.78rem;
line-height:1.8;color:var(–green);white-space:pre-wrap;word-break:break-word;
display:none;
}
.api-result.visible{display:block;}
.api-result.error{color:var(–red);}
.api-result.loading{color:var(–dim);}

.spin{display:inline-block;animation:spin .6s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}

/* ─── SKILLS ─── */
#skills{padding-bottom:80px;}
.skills-wrap{max-width:900px;margin:0 auto;padding:0 24px;}
.skill-row{
display:flex;align-items:center;gap:16px;margin-bottom:20px;
padding:16px 20px;background:var(–panel);border:1px solid var(–border);
border-radius:4px;
}
.skill-name{
font-family:‘Share Tech Mono’,monospace;font-size:.8rem;
letter-spacing:.08em;min-width:120px;color:var(–text);
}
.skill-bar{flex:1;height:4px;background:#ffffff10;border-radius:2px;overflow:hidden;}
.skill-fill{
height:100%;border-radius:2px;
background:linear-gradient(90deg,var(–cyan),var(–green));
transform:scaleX(0);transform-origin:left;
transition:transform 1.2s cubic-bezier(.4,0,.2,1);
}
.skill-row.visible .skill-fill{transform:scaleX(1);}
.skill-pct{
font-family:‘Orbitron’,monospace;font-size:.75rem;
color:var(–cyan);min-width:36px;text-align:right;
}

/* ─── FOOTER ─── */
footer{
position:relative;z-index:2;border-top:1px solid var(–border);
padding:40px 24px;text-align:center;
font-family:‘Share Tech Mono’,monospace;font-size:.7rem;
color:var(–dim);letter-spacing:.1em;
}
footer span{color:var(–cyan);}

/* ─── UTILITY ─── */
.fade-in{opacity:0;transform:translateY(20px);transition:opacity .7s,transform .7s;}
.fade-in.visible{opacity:1;transform:none;}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar{width:6px;height:6px;}
::-webkit-scrollbar-track{background:var(–bg);}
::-webkit-scrollbar-thumb{background:#0ff4;border-radius:3px;}

@media(max-width:600px){
nav ul{gap:16px;}
nav{padding:12px 20px;}
}
</style>

</head>
